---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { FloatingActions } from '../components/FloatingActions';
import { ArrowRight, Home, Search, Phone } from 'lucide-react';
---

<Layout
  title="Page Not Found | SLV Pest Control"
  description="The page you are looking for does not exist. Browse our pest control services or return to the homepage."
>
  <Header client:load />

  <main class="min-h-[75vh] flex items-center justify-center relative overflow-hidden py-24 px-4 bg-[#0a0b0e]">
    {/* Ambient background glows */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#E5A93C]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#E5A93C]/10 border border-[#E5A93C]/30 text-[#F6C453] text-xs font-bold tracking-widest uppercase mb-6">
        <span>404 Error</span>
      </div>

      <h1 class="text-7xl sm:text-8xl font-black text-white tracking-tight mb-4 font-heading">
        <span class="slv-gold-text">404</span>
      </h1>

      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
        Page Not Found
      </h2>

      <p class="text-zinc-400 text-sm sm:text-base mb-8 max-w-md mx-auto">
        The page you requested could not be found. It may have been moved, renamed, or is temporarily unavailable.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a
          href="/"
          class="slv-btn-primary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold gap-2 inline-flex items-center justify-center"
        >
          <Home class="w-4 h-4" />
          <span>Return Home</span>
        </a>
        <a
          href="/services"
          class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold gap-2 inline-flex items-center justify-center"
        >
          <Search class="w-4 h-4" />
          <span>Browse Services</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="mt-12 pt-8 border-t border-zinc-800/80 text-xs text-zinc-500">
        Need immediate pest control assistance in Bangalore? Call us at <a href="tel:9180397822" class="text-[#F6C453] hover:underline font-semibold">+91 80 3978 22</a>
      </div>
    </div>
  </main>

  <Footer client:load />
  <FloatingActions client:load />
</Layout>
