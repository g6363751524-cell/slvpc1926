---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { FloatingActions } from '../../components/FloatingActions';
import { ContactForm } from '../../components/ContactForm';
import ServiceAreasSection from '../../components/ServiceAreasSection.astro';
import {
  Sparkles,
  Shield,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  Search,
  Layers,
  Phone,
  MessageCircle,
  Mail,
  ArrowRight,
  Clock,
  MapPin,
  Home,
  Building,
  UtensilsCrossed,
  HelpCircle,
  BookOpen,
  Eye,
  Activity,
  FileText,
  DoorOpen,
  Waves,
  Box,
  Flame,
  Package,
  Wrench,
  Droplets,
  Trash2
} from 'lucide-react';

const signs = [
  {
    title: 'Frequent Fly Activity Indoors',
    desc: 'Persistent houseflies, fruit flies, or drain flies buzzing around rooms, light sources, prep counters, and seating areas throughout the day.',
    icon: Activity
  },
  {
    title: 'Flies Gathering Around Food & Drains',
    desc: 'Clusters of flies feeding on fresh produce, uncovered food dishes, waste bins, grease traps, or congregating along illuminated window panes.',
    icon: Trash2
  },
  {
    title: 'Small Dark Spots / Fly Specks',
    desc: 'Visible dark regurgitation and fecal spots left on illuminated walls, light fixtures, upper door frames, and ceiling surfaces.',
    icon: Sparkles
  },
  {
    title: 'Maggots or Larvae in Waste & Drains',
    desc: 'Small pale larvae active in trash can liners, decomposing waste, compost buckets, grease build-ups, or uncleaned drain floor traps.',
    icon: Search
  }
];

const harbourageAreas = [
  { name: 'Kitchen & Prep Stations', desc: 'Cutting tables, counter splashbacks, and grease-accumulating surfaces' },
  { name: 'Garbage & Waste Bins', desc: 'Internal trash cans, compactor rooms, wet liners, and disposal bays' },
  { name: 'Floor & Sink Drains', desc: 'U-bends, floor traps, and scuppers harbouring gelatinous bacterial slime' },
  { name: 'Pantries & Food Storage', desc: 'Fruit baskets, beverage dispensers, syrup taps, and fermentation spots' },
  { name: 'Compost & Wet Waste', desc: 'Balcony scrap bins, wet vegetable disposal, and damp outdoor vegetation' },
  { name: 'Doors & Window Entries', desc: 'Frequently opened service doors, torn window screens, and entry docks' }
];

const fourStageProcess = [
  {
    step: '01',
    title: 'Inspection & Breeding Mapping',
    description: 'Identify species and locate breeding sources.',
    detail: 'Our certified technician systematically inspects kitchen areas, floor drains, waste storage, and structural entry points to identify specific fly species and map breeding zones.',
    icon: Search
  },
  {
    step: '02',
    title: 'Targeted Bio-Drain & Surface Action',
    description: 'Treat larval breeding sites and adult resting surfaces.',
    detail: 'Deployment of targeted residual barrier treatments, enzymatic bio-drain foam treatments to dissolve organic slime, and insect growth regulators to halt larval development.',
    icon: Layers
  },
  {
    step: '03',
    title: 'Monitoring & Residual Fly Trapping',
    description: 'Monitor activity and deploy strategic traps.',
    detail: 'Strategic placement of electronic insect light traps (ILTs), pheromone sticky boards, and perimeter barriers in high-traffic fly paths to monitor lingering activity.',
    icon: Activity
  },
  {
    step: '04',
    title: 'Prevention Guidance & Exclusion',
    description: 'Provide practical recommendations to reduce future ingress.',
    detail: 'Actionable guidance on air curtain positioning, door brush seal installation, waste management schedules, drain flushing routines, and window mesh maintenance.',
    icon: ShieldCheck
  }
];

const propertiesWeTreat = [
  'Homes & Villas',
  'Apartments & High-Rises',
  'Paying Guest (PG) Accommodations',
  'Hotels & Hostels',
  'Restaurants & Cloud Kitchens',
  'Corporate Offices & Cafeterias',
  'Retail Outlets & Supermarkets',
  'Commercial Food Facilities'
];

const knowledgeArticles = [
  {
    title: 'Fly Identification Guide',
    desc: 'Learn how to differentiate common houseflies, drain flies, fruit flies, and blowflies by size, breeding habits, and flight patterns.',
    href: '/knowledge/treatment#species-diagnostics'
  },
  {
    title: 'Where Flies Breed Indoors',
    desc: 'Discover why flies thrive around wet kitchen waste, floor drains, fermented food scraps, unsealed trash cans, and damp organic build-up.',
    href: '/knowledge/treatment#moisture-drainage'
  },
  {
    title: 'How Flies Enter & Spread',
    desc: 'Understand entry vectors: open doors, unscreened windows, negative air pressure, and delivery crates that transport flies indoors.',
    href: '/knowledge/treatment#entry-exclusion'
  },
  {
    title: 'Fly Prevention Checklist',
    desc: 'Proactive sanitation measures including prompt trash disposal, sealed container storage, enzymatic drain maintenance, and mesh screens.',
    href: '/knowledge/treatment#sanitation-rules'
  },
  {
    title: 'Fly Treatment Guide',
    desc: 'A comprehensive overview of commercial and residential fly management: bio-foaming drains, targeted residual barriers, and UV light traps.',
    href: '/knowledge/treatment#ipm-methodology'
  },
  {
    title: 'Fly Management FAQ',
    desc: 'Answers to key questions regarding fly disease vectors, food contamination risks, safe chemical usage, and commercial hygiene compliance.',
    href: '/knowledge/treatment#treatment-faqs'
  }
];

const prepSteps = [
  'Keep food covered and stored in airtight cabinets, containers, or refrigerators.',
  'Clear access around kitchen counters, sink areas, floor drains, and waste disposal bins.',
  'Empty and thoroughly wash out interior kitchen dustbins prior to technician arrival.',
  'Inform the technician about specific areas exhibiting peak fly activity or breeding clusters.'
];

const aftercareSteps = [
  'Maintain strict waste hygiene by bagging wet organic scraps and emptying trash bins daily.',
  'Keep all prepared food and fresh fruit covered and stored correctly at all times.',
  'Flush sink and floor drains regularly to prevent organic biofilm and slime accumulation.',
  'Follow technician instructions regarding trap inspections and preventative maintenance.'
];

const faqs = [
  {
    q: 'Why do flies enter homes and businesses?',
    a: 'Flies are attracted by olfactory cues from food preparation, warm indoor air currents, decomposing organic waste, ripe fruit, and uncleaned drains. They easily enter through unsealed doors, windows, exhaust vents, and delivery bays.'
  },
  {
    q: 'Where do flies breed?',
    a: 'Flies breed in moist, rotting organic matter. Common houseflies lay eggs in garbage and animal waste; fruit flies breed in fermenting fruits and sugary spills; and drain flies breed in the gelatinous organic slime lining sink and floor drain pipes.'
  },
  {
    q: 'Why are flies common around drains and waste?',
    a: 'Drains collect organic grime, grease, and hair, creating a nutrient-rich bacterial film where drain fly larvae thrive. Waste areas provide abundant decaying matter, warm humidity, and undisturbed shelter ideal for rapid fly reproduction.'
  },
  {
    q: 'How does professional fly treatment work?',
    a: 'Our approach combines breeding-source elimination (such as bio-enzymatic drain cleaning), targeted residual application on resting surfaces, insect growth regulators to disrupt the life cycle, and strategic placement of non-toxic light or pheromone traps.'
  },
  {
    q: 'Is preparation required before fly treatment?',
    a: 'Yes. Basic preparation involves covering food, clearing access around kitchen sinks, floor drains, and trash stations, and securing waste. Our technician provides customized prep instructions during scheduling.'
  },
  {
    q: 'How much does professional fly control cost in Bangalore?',
    a: 'Fly control at SLV Pest Control starts from ₹499. Pricing is confirmed based on property size, severity of fly activity, identified breeding sources, and required treatment methods during on-site assessment.'
  },
  {
    q: 'Can restaurants, apartments, PGs, offices, and commercial properties be treated?',
    a: 'Yes. SLV Pest Control provides specialized fly management programs tailored to commercial kitchens, restaurants, corporate cafeterias, supermarkets, apartment complexes, and residential villas across Bangalore adhering to food safety standards.'
  }
];
---

<Layout
  title="Fly Control in Bangalore | Starting at ₹499 | SLV Pest Control"
  description="Professional house fly, drain fly & fruit fly control in Bangalore. Targeted bio-drain foaming & perimeter barrier protection. Starting ₹499. Call 91803 97822."
  canonical="https://slvpestcontrol.com/services/fly-control"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://slvpestcontrol.com/services/fly-control#service",
          "name": "Fly Control in Bangalore",
          "serviceType": "Fly Pest Control Service",
          "provider": {
            "@type": "LocalBusiness",
            "name": "SLV Pest Control",
            "telephone": "+91-9180397822",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "143 Soundarya Layout, Doddabidarakallu",
              "addressLocality": "Bengaluru",
              "addressRegion": "Karnataka",
              "postalCode": "560073",
              "addressCountry": "IN"
            }
          },
          "areaServed": {
            "@type": "City",
            "name": "Bengaluru"
          },
          "offers": {
            "@type": "Offer",
            "price": "499",
            "priceCurrency": "INR"
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://slvpestcontrol.com/services/fly-control#faq",
          "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.q,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.a
            }
          }))
        }
      ]
    })} />
  </Fragment>

  <Header client:load activeItem="services" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-[#F6C453] font-semibold">Fly Control</span>
      </nav>
    </div>

    {/* ============================================================== */}
    {/* 1. HERO SECTION                                               */}
    {/* ============================================================== */}
    <section class="relative z-10 pt-10 sm:pt-14 lg:pt-18 pb-14 sm:pb-18 border-b border-white/[0.06] overflow-hidden bg-[#090a0c]">
      {/* Atmospheric dark overlays preserving crisp typography contrast */}
      <div 
        class="absolute inset-0 bg-radial-[at_50%_50%] from-[#090a0c]/80 via-[#090a0c]/75 to-[#090a0c]/85 pointer-events-none"
        aria-hidden="true"
      ></div>

      {/* Top & bottom gentle gradient fades connecting seamlessly */}
      <div 
        class="absolute inset-0 bg-gradient-to-b from-[#090a0c]/75 via-transparent to-[#090a0c] pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto">
          {/* Eyebrow badge */}
          <div class="inline-flex items-center gap-2 mb-5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-[#E5A93C] animate-pulse"></span>
            <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.25em] uppercase">
              FLY CONTROL IN BANGALORE
            </span>
          </div>

          {/* H1 */}
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-5 font-heading">
            Fly Control in <span class="slv-gold-text">Bangalore</span>
          </h1>

          {/* Supporting message */}
          <p class="text-xl sm:text-2xl font-bold text-white mb-6 font-heading tracking-tight">
            Clean &amp; hygienic spaces
          </p>

          <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8 font-normal">
            SLV Pest Control provides professional housefly, drain fly, and fruit fly inspection and targeted eradication across Bangalore. Our disciplined 4-stage process controls flies at their breeding sources in homes, apartments, cloud kitchens, and commercial food establishments.
          </p>

          {/* Pricing indicator */}
          <div class="inline-flex items-center gap-4 px-4 py-2 rounded-2xl bg-white/[0.03] border border-white/[0.08] mb-8 text-xs sm:text-sm font-semibold">
            <span class="text-[#F6C453] font-bold">Starting at ₹499</span>
            <span class="text-zinc-600">|</span>
            <span class="text-white uppercase tracking-wider text-[11px] sm:text-xs">Bio-Drain &amp; Barrier Defense</span>
          </div>

          {/* CTAs */}
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
            <a
              href="/contact"
              class="slv-btn-primary w-full sm:w-auto px-8 py-3.5 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4" />
            </a>

            <a
              href="tel:9180397822"
              class="slv-btn-secondary w-full sm:w-auto px-7 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider hover:border-[#F6C453]"
            >
              <Phone class="w-4 h-4 text-[#F6C453]" />
              <span>Call Now</span>
            </a>

            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md transition-all inline-flex items-center justify-center"
            >
              <MessageCircle class="w-4 h-4 text-white" />
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 2. SIGNS OF FLIES                                             */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              IDENTIFICATION
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading">
            Common Signs of Flies
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-3">
            Inspect your kitchen, dining area, and plumbing drains for these characteristic indicators.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {signs.map((sign) => {
            const Icon = sign.icon;
            return (
              <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                <div>
                  <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                    <Icon class="w-5 h-5 text-[#E5A93C]" />
                  </div>
                  <h3 class="text-base sm:text-lg font-bold text-white mb-2">
                    {sign.title}
                  </h3>
                  <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                    {sign.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 3. WHERE FLIES BREED & GATHER                                 */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              HARBOURAGE &amp; BREEDING AREAS
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            Where Flies Breed &amp; Gather
          </h2>
          <p class="text-zinc-400 text-sm mt-3">
            Primary nesting and shelter locations close to moisture, decomposing organic matter, and food residues.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {harbourageAreas.map((item) => (
            <div class="slv-card rounded-2xl p-5 border border-white/[0.07] flex flex-col justify-between">
              <div>
                <h3 class="text-sm sm:text-base font-bold text-[#F6C453] mb-1.5">{item.name}</h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 4. OUR 4-STAGE TREATMENT PROCESS                              */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 lg:py-24 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-18">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              TREATMENT PROCESS
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading">
            Our 4-Stage Treatment Process
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-4">
            A property-specific approach focused on root-cause inspection, bio-enzymatic drain foaming, adult trapping, and sustained prevention.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {fourStageProcess.map((stage) => {
            const Icon = stage.icon;
            return (
              <div class="slv-card rounded-2xl p-7 flex flex-col justify-between border border-white/[0.08] hover:border-[#E5A93C]/50 transition-all">
                <div>
                  <div class="flex items-center justify-between mb-5">
                    <span class="text-3xl font-black font-heading slv-gold-text tracking-tighter">
                      {stage.step}
                    </span>
                    <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-[#E5A93C]">
                      <Icon class="w-5 h-5 text-[#E5A93C]" />
                    </div>
                  </div>

                  <h3 class="text-lg font-bold text-white font-heading mb-2">
                    {stage.title}
                  </h3>
                  <p class="text-[#FFE08A] text-xs font-semibold mb-3">
                    {stage.description}
                  </p>
                  <p class="text-zinc-400 text-xs sm:text-[13px] leading-relaxed">
                    {stage.detail}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] text-zinc-500 font-mono">
                  Phase {stage.step} of 04
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 5. PROPERTIES WE TREAT                                        */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              COVERAGE
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight font-heading">
            Properties We Treat
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-3">
            Customized fly management across residential, commercial food service, and industrial facilities.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-5xl mx-auto">
          {propertiesWeTreat.map((prop) => (
            <div class="slv-card rounded-2xl p-5 border border-white/[0.07] text-center flex flex-col items-center justify-center">
              <Building class="w-6 h-6 text-[#E5A93C] mb-2" />
              <span class="text-sm font-bold text-white">{prop}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 6. DEDICATED PRICING SECTION                                  */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="slv-card rounded-3xl p-8 sm:p-14 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.25em] uppercase block mb-3">
            TRANSPARENT PRICING
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white font-heading mb-6">
            FLY CONTROL
          </h2>
          <div class="my-6">
            <span class="text-zinc-400 text-base sm:text-lg mr-2 font-medium">Starting at</span>
            <span class="text-4xl sm:text-5xl lg:text-6xl font-black text-white font-mono tracking-tight text-[#F6C453]">
              ₹499
            </span>
          </div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.04] border border-white/[0.08] mb-8">
            <ShieldCheck class="w-4 h-4 text-[#E5A93C]" />
            <span class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">
              Bio-Drain &amp; Barrier Defense
            </span>
          </div>
          <p class="text-zinc-400 text-xs sm:text-sm max-w-md mx-auto mb-8 leading-relaxed">
            Starting price applies to basic residential kitchen or drain scope. Detailed pricing is confirmed based on property size, breeding extent, and commercial compliance requirements during initial assessment.
          </p>
          <div class="flex justify-center">
            <a
              href="/contact"
              class="slv-btn-primary px-8 py-4 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 7. LEARN MORE ABOUT FLIES (KNOWLEDGE HUB CARDS)               */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 lg:py-24 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
